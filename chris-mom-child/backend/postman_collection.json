{
  "info": {
    "name": "Chris Mom & Chris Child API",
    "description": "Postman collection for the Secret Match backend API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"USER\",\n  \"floor\": \"7th Floor\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login (Admin or User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in the user and automatically saves the JWT token to the collection variables. (Use admin@example.com / admin for the auto-seeded Admin)"
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Admin Controls (Requires Admin Token)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            }
          }
        },
        {
          "name": "Start Game (Generates Pairs)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/games/1/start",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "games", "1", "start"]
            }
          }
        },
        {
          "name": "Get All Matches",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/matches",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "matches"]
            }
          }
        },
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tasks"]
            }
          }
        },
        {
          "name": "Approve Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/tasks/1/approve",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tasks", "1", "approve"]
            }
          }
        },
        {
          "name": "Reject Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/tasks/1/reject",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tasks", "1", "reject"]
            }
          }
        },
        {
          "name": "Final Reveal (Ends Game)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/games/1/reveal",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "games", "1", "reveal"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Game & Missions",
      "item": [
        {
          "name": "Get My Identities (Mom/Child)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/games/my-identities",
              "host": ["{{baseUrl}}"],
              "path": ["games", "my-identities"]
            }
          }
        },
        {
          "name": "Create Mission (As Mom)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}"},
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bake cookies\",\n  \"description\": \"Make some chocolate chip cookies for the party!\",\n  \"points\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/games/mom/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["games", "mom", "tasks"]
            }
          }
        },
        {
          "name": "Get Created Missions (As Mom)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/games/mom/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["games", "mom", "tasks"]
            }
          }
        },
        {
          "name": "Get Assigned Missions (As Child)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/games/child/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["games", "child", "tasks"]
            }
          }
        }
      ]
    }
  ]
}
